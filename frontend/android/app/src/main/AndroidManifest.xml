<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_flame_default"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_flame_default_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- The launcher entry lives on the Icon_* aliases below (dynamic app icon). -->
        </activity>

        <!-- Dynamic app icon: one alias per icon, all opening MainActivity. Exactly one is enabled at a time
             (StudyIconPlugin). The default alias is enabled in the manifest so a fresh install always has an icon. -->
        <activity-alias
            android:name=".Icon_flame_default"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_flame_default"
            android:roundIcon="@mipmap/ic_flame_default_round"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_flame_focused"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_flame_focused"
            android:roundIcon="@mipmap/ic_flame_focused_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_flame_celebrating"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_flame_celebrating"
            android:roundIcon="@mipmap/ic_flame_celebrating_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_flame_sleepy"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_flame_sleepy"
            android:roundIcon="@mipmap/ic_flame_sleepy_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_flame_away"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_flame_away"
            android:roundIcon="@mipmap/ic_flame_away_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_flame_welcome"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_flame_welcome"
            android:roundIcon="@mipmap/ic_flame_welcome_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_flame_streak"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_flame_streak"
            android:roundIcon="@mipmap/ic_flame_streak_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_flame_goal_complete"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_flame_goal_complete"
            android:roundIcon="@mipmap/ic_flame_goal_complete_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_flame_resting"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_flame_resting"
            android:roundIcon="@mipmap/ic_flame_resting_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_flame_motivated"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_flame_motivated"
            android:roundIcon="@mipmap/ic_flame_motivated_round"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Study reminders: fired by AlarmManager, restored after a restart -->
        <receiver android:name=".ReminderReceiver" android:exported="false" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets (Streak + mascot, Tasks, Focus shortcut, Week) -->
        <receiver android:name=".StreakWidgetProvider" android:exported="true" android:label="StudyOS Streak">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_streak_info" />
        </receiver>
        <receiver android:name=".TasksWidgetProvider" android:exported="true" android:label="StudyOS Tasks">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tasks_info" />
        </receiver>
        <receiver android:name=".FocusWidgetProvider" android:exported="true" android:label="StudyOS Focus">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_focus_info" />
        </receiver>
        <receiver android:name=".WeekWidgetProvider" android:exported="true" android:label="StudyOS Week">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_week_info" />
        </receiver>
        <!-- Mood alarm, mascot tap, and every clock change that can move the local day or the night hours -->
        <receiver android:name=".WidgetRefreshReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.studyos.app.WIDGET_REFRESH" />
                <action android:name="com.studyos.app.WIDGET_TIP" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Exact alarms: reminders fire on the minute instead of being batched by Android -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
