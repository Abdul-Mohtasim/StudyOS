<?xml version="1.0" encoding="utf-8"?>
<!-- Streak + Mascot widget: the animated-in-spirit mood mascot, the current streak,
     today's progress bar and a short mood line. RemoteViews can't run CSS-style
     animation, so "animated" here means the mascot art and message change instantly
     and smoothly swap every time the mood engine recalculates (task done, time passing). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_mauve">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_mascot"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/mascot_happy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1B1E25"
                android:text="0 day streak" />

            <TextView
                android:id="@+id/widget_mood_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="#6B6E76"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Let's get some studying in." />

            <ProgressBar
                android:id="@+id/widget_goal_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#E4585F"
                android:progressBackgroundTint="#DEDCDD" />

            <TextView
                android:id="@+id/widget_goal_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textColor="#6B6E76"
                android:text="0 / 30 min today" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
