# Copy this file to .env and fill in your own values (keep your existing .env as it is).
NODE_ENV=production
PORT=5000
FRONTEND_URL=
MONGODB_URI=
GOOGLE_CLIENT_ID=
JWT_SECRET=

# --- Email (see UPDATE_GUIDE_4_EMAILS.md) ---
# Use ONE provider: Resend or Brevo.
RESEND_API_KEY=
BREVO_API_KEY=
# Sender shown on emails, for example: StudyOS <no-reply@yourdomain.com>
MAIL_FROM=
# Long random text. The scheduler sends it as "Authorization: Bearer <value>".
CRON_SECRET=
# Time zone used for people who have not opened Settings yet, for example Europe/London.
DEFAULT_TIMEZONE=UTC

# --- Speed and load (all optional; see UPDATE_GUIDE_5_SCALING.md) ---
# Worker processes. Default: up to 2 (one per CPU core). Use 1 on very small plans, 3-4 on bigger ones.
WEB_CONCURRENCY=
# MongoDB connections per worker (default 20). Keep WEB_CONCURRENCY x this below your database limit.
MONGO_POOL_SIZE=
# A worker answers "busy, retry" above this many requests at once (default 300).
MAX_IN_FLIGHT=
# General limit per IP per 15 minutes (default 3000) and for sign-in/sign-up (default 150).
API_RATE_LIMIT=
AUTH_RATE_LIMIT=
# Optional: full URL of the logo shown in emails. Default: FRONTEND_URL + /icons/email-logo.png
EMAIL_LOGO_URL=
